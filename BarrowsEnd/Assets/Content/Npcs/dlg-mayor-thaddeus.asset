          high: -4279305738254098879
        editorPosition: {x: 0, y: 0}
        speakerName: Mayor Thaddeus
        text: Excellent. Head past the northern barricades. The guards have orders to let you through.
        nextNodeId:
          low: -6674083795254070407
          high: -8775704770207652925
    - rid: 4304781063743864922
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId:
          low: -1004834837973872468
          high: 6807351834014827338
        editorPosition: {x: 0, y: 0}
        speakerName: Mayor Thaddeus
        text: Recruit the rest of your squad first. Garrick, Elara, and Silas are all still in town -- come back when you're ready.
        nextNodeId:
          low: -6674083795254070407
          high: -8775704770207652925
    - rid: 4304781063743864923
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
