          low: 5159471087248722001
          high: -7596680350364665787
        editorPosition: {x: 0, y: 0}
        speakerName: Narrator
        text: Silence settles over the Deep Dark -- the old silence, not the hungry one. Far above, Barrow's End will sleep tonight.
        nextNodeId:
          low: -5788534925383793184
          high: 7655867986874063456
    - rid: 2954408722827837444
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
