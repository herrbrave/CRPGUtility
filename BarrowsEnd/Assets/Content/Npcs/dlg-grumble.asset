          high: 7236300844087193289
        editorPosition: {x: 0, y: 0}
        speakerName: Grumble
        text: You look like the sort who could brave the caverns for me. Giant mushrooms down there, real delicacies -- ask me again once you've made some progress.
        nextNodeId:
          low: 6114180659835385954
          high: -8637442658214050479
    - rid: 2954408717933871115
