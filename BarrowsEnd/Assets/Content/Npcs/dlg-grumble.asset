          low: 8414103608967391244
          high: -7868159666045931793
        editorPosition: {x: 0, y: 0}
        speakerName: Grumble
        text: You made it past the rats -- good. Bring me three giant mushrooms from down in the caverns and I'll make it worth your while.
        nextNodeId:
          low: -9151982364083661662
          high: 7058742024438728507
