  m_Name: ConditionDefinition_Exhaustion
  m_EditorClassIdentifier: CRPG.Actors::CRPG.Actors.ConditionDefinition
  id: condition-exhaustion
  displayName: Exhaustion
  description: Effects are cumulative and tracked as a stacking level (see ExhaustionService), from 1 (disadvantage on ability checks) to 6 (death). Level 2+ halves speed and level 5+ reduces it to 0 -- both enforced automatically by DefaultMovementSpeedRule. Level 6 is instant death, reported by ExhaustionService.IncreaseExhaustion. Disadvantage on ability checks/attacks/saves and halved hit point maximum are not currently enforced.
  modifiers: []
  preventsActions: 0
