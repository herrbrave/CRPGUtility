  m_Name: FeatureDefinition_Expertise
  m_EditorClassIdentifier: CRPG.Actors::CRPG.Actors.FeatureDefinition
  id: feature-expertise
  displayName: Expertise
  description: 'Choose 2 of your skill proficiencies. Your proficiency bonus is doubled for any ability check you make that uses either of the chosen proficiencies. INERT: RuleModifierOperation.GrantExpertise exists in the shared enum specifically for this, but nothing in the engine consumes it yet. The player-facing choice below is real; the numeric doubling it should eventually grant per chosen skill is not wired up.'
  modifiers: []
  grantedAbilityIds: []
  grantedResources: []
  grantedProficiencies: []
  choices:
  - id: choose-expertise-skills
    displayName: Choose 2 skills for Expertise
    type: 2
    options:
    - value: skill-acrobatics
    - value: skill-athletics
    - value: skill-deception
    - value: skill-insight
    - value: skill-intimidation
    - value: skill-investigation
    - value: skill-perception
    - value: skill-performance
    - value: skill-persuasion
    - value: skill-sleight-of-hand
    - value: skill-stealth
    filterTag: 
    count: 2
