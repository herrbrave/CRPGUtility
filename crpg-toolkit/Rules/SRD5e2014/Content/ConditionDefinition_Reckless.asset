  m_Script: {fileID: 11500000, guid: 0ec7340e5cf4c784daa235b7b6f353a8, type: 3}
  m_Name: ConditionDefinition_Reckless
  m_EditorClassIdentifier: CRPG.Actors::CRPG.Actors.ConditionDefinition
  id: condition-reckless
  displayName: Reckless
  description: 'You are attacking recklessly: you have advantage on melee weapon attack rolls using Strength during this turn, but attack rolls against you have advantage until your next turn. REAL/WORKING: grants Advantage under the shared "AttackBonus" query key (your own attack rolls while this condition applies) and Disadvantage under "AttacksAgainst" (per this engine''s existing DefaultAttackBonusRule.ComputeAdvantage convention, where an AttacksAgainst-tagged modifier expresses the state that gets combined into attacks targeting you). Both are gathered and combined automatically by the existing DefaultAttackBonusRule/AdvantageCollector machinery, so this functions correctly at runtime today.'
  modifiers:
  - queryKey: AttackBonus
    operation: 6
    value: 0
    priority: 0
  - queryKey: AttacksAgainst
    operation: 7
    value: 0
    priority: 0
