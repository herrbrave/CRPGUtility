      data:
        nodeId:
          low: 5410335366633465325
          high: 4905219601168281494
        editorPosition: {x: 0, y: 0}
        speakerName: Eldor
        text: Greetings, traveler. You arrive at a dark hour. My son, Elian, is missing. He was investigating the old well. Goblins... I fear they took him. Find him, please, and I will reward you dearly.
        nextNodeId:
          low: 5475100572283454029
          high: -1074148236335513926
    - rid: 4304780615459536934
