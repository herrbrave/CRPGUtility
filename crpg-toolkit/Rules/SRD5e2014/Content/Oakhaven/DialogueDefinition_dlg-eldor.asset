          high: -2169823209827953503
        editorPosition: {x: 0, y: 0}
        speakerName: Eldor
        text: Take this family heirloom -- a Ring of Protection. It saved my father; may it save you.
        nextNodeId:
          low: 5371963411559620666
          high: -4909725883238091362
    - rid: 4304780615459536943
