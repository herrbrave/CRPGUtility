      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId: intro
        speakerName: You
        text: The well plunges into darkness. A knotted rope leads down into a damp, torch-lit cavern. Two goblin sentries pace an upper ledge above, unaware of you... for now.
        nextNodeId: check
    - rid: 4304780615459536915
      type: {class: CheckNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId: check
        queryKey: Skill:Acrobatics
