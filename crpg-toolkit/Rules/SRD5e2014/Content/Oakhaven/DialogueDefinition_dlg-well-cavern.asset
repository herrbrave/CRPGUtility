        performer: 1
        successNodeId: success-line
        failureNodeId: failure-line
    - rid: 4304780615459536916
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId: success-line
        speakerName: You
        text: You slip past the ledge unseen, the sentries none the wiser.
        nextNodeId: pass-action
    - rid: 4304780615459536917
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId: failure-line
        speakerName: You
        text: A loose stone clatters away beneath your foot. The sentries snap alert -- but by the time they scramble down, you're already past, deeper into the dark.
        nextNodeId: pass-action
    - rid: 4304780615459536918
      type: {class: ActionNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
