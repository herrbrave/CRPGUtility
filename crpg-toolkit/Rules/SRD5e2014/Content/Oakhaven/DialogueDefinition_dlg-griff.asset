    - rid: 4304780615459536906
      type: {class: LineNode, ns: CRPG.Dialogue, asm: CRPG.Dialogue}
      data:
        nodeId: cleared-line
        speakerName: Griff
        text: Ore's flowing again thanks to you. Name's good with me -- take a look, prices are fair now.
